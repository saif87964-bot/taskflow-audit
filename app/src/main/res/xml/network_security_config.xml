<?xml version="1.0" encoding="utf-8"?>
<!--
  Blocks all cleartext (non-HTTPS) traffic. Standard system trust anchors
  are used for TLS validation.

  NOTE: Certificate pinning was deliberately removed. Google rotates the
  certificates on *.googleapis.com across multiple roots (GTS R1–R4), so
  pinning those domains intermittently bricks Firebase Auth/Firestore with
  "Pin verification failed" depending on the network path. Google explicitly
  advises against pinning their API endpoints.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
